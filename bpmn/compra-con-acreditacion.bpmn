      <bpmndi:BPMNShape id="C_Stock_di" bpmnElement="C_Stock"><dc:Bounds x="434" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="H_Stock_di" bpmnElement="H_Stock"><dc:Bounds x="420" y="330" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Cobro_di" bpmnElement="T_Cobro"><dc:Bounds x="590" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Cobro_di" bpmnElement="E_Cobro"><dc:Bounds x="654" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="575" y="88" width="130" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_Cobro_di" bpmnElement="C_Cobro"><dc:Bounds x="604" y="222" width="36" height="36" /></bpmndi:BPMNShape>
