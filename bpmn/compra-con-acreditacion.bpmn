      <bpmndi:BPMNShape id="T_Envio_di" bpmnElement="T_Envio"><dc:Bounds x="866" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Envio_di" bpmnElement="E_Envio"><dc:Bounds x="930" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="851" y="88" width="130" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FinOk_di" bpmnElement="FinOk"><dc:Bounds x="1036" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1014" y="224" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Compensar_di" bpmnElement="Compensar"><dc:Bounds x="1156" y="52" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1116" y="0" width="116" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FinCompensada_di" bpmnElement="FinCompensada"><dc:Bounds x="1256" y="52" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1236" y="94" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A_Orden_di" bpmnElement="A_Orden"><di:waypoint x="282" y="258" /><di:waypoint x="282" y="330" /></bpmndi:BPMNEdge>
