# Copiar a .env (cp .env.example .env) y completar en CADA laptop.
# IP de la laptop orquestadora (la que corre `docker compose up`) + puerto del gateway gRPC.
ZEEBE_ADDRESS=localhost:26500
# Nombre que aparece en los logs de cada worker, ej: laptop-matias
WORKER_NAME=laptop-matias
# Solo si el cluster exige OAuth (el compose de la demo NO lo exige; dejar vacío):
# ZEEBE_CLIENT_ID=
# ZEEBE_CLIENT_SECRET=
# ZEEBE_AUTHORIZATION_SERVER_URL=
# Opcionales
# JOB_TIMEOUT_MS=25000
# FALLAS_TECNICAS=3
